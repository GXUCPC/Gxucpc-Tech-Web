{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": [
    "src/**/__tests__/*",
    "src/components/FeedbackModal.vue",
    "src/components/LoginWindow.vue",
    "src/pages/admin/**",
    "src/pages/articles/**",
    "src/pages/xcpc/competitionSignUp.vue",
    "src/pages/tech/Interview.vue"
  ],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
